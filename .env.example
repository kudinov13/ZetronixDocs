# Настройки сервера ZenzaDocs
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zenzadocs
DB_USER=zenza
DB_PASSWORD=zenza_password

# JWT секрет для админ-аутентификации сервера
JWT_SECRET=change-this-to-random-string

# Пути к RSA ключам для подписи лицензий
PRIVATE_KEY_PATH=./keys/private_key.pem
PUBLIC_KEY_PATH=./keys/public_key.pem

# Стоимость токенов (в рублях за 1000 токенов)
# Используется для расчёта отчётов
COST_PER_1K_TOKENS_STANDARD=0.50
COST_PER_1K_TOKENS_EXTENDED=2.00
COST_PER_1K_TOKENS_STRUCTURE=0.30
